# Copy to .env and fill in. Never commit .env.

# ---- Behaviour ---------------------------------------------------------------
# Start with DRY_RUN=true: it logs what it would create and who it would assign,
# and writes nothing to SDP or Arctic Wolf. Set to false to go live.
DRY_RUN=true
POLL_SECONDS=60
LOG_LEVEL=INFO

# ---- Arctic Wolf -------------------------------------------------------------
# Your region: US001 / US002 / US003 / EU001 / AU001 / CA001
AW_BASE_URL=https://ticket-api.managedgw.us001-prod.arcticwolf.net
AW_API_TOKEN=
AW_ORG_UUID=
AW_OPEN_STATUSES=NEW,OPEN,HOLD,PENDING
# false = only tickets created after the first live run are imported.
# true  = also import every ticket that is open at the first live run.
AW_BACKFILL_OPEN=false

# ---- ServiceDesk Plus Cloud --------------------------------------------------
# Include your portal path. US data center example:
SDP_BASE_URL=https://sdpondemand.manageengine.com/app/itdesk
# Zoho accounts server for your data center (.com, .eu, .in, .com.au, .jp, .ca, ...)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Status set when a ticket is auto-assigned (the "acknowledge" step).
# Must match a status name that exists in your SDP instance.
SDP_ACK_STATUS=In Progress
# SDP statuses that close the Arctic Wolf ticket. Comma-separated.
SDP_CLOSE_STATUSES=Resolved,Closed

# Optional request fields
SDP_REQUESTER_EMAIL=
SDP_GROUP=
# API key of a single-line request field that holds the AW ticket ID (e.g. udf_sline_301)
SDP_AW_ID_UDF=
# Who gets the ticket if PagerDuty has nobody mapped on shift. Blank = leave unassigned.
SDP_FALLBACK_TECHNICIAN_EMAIL=

# Arctic Wolf priority -> SDP priority name
SDP_PRIORITY_LOW=Low
SDP_PRIORITY_NORMAL=Medium
SDP_PRIORITY_HIGH=High
SDP_PRIORITY_URGENT=Urgent

# ---- PagerDuty ---------------------------------------------------------------
# A read-only REST API key is enough; the service only reads the schedule.
PD_API_TOKEN=
PD_SCHEDULE_ID=
HANDOFF_MINUTES=30
PD_LOOKAHEAD_HOURS=48

# ---- Paths (defaults suit the container) -------------------------------------
IDENTITY_MAP_PATH=/app/config/identity_map.csv
DB_PATH=/data/state.db
