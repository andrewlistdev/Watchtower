# Watchtower. You don't need a .env file: credentials and settings are entered on the
# admin page (http://localhost:8080 → Settings) and stored encrypted.
#
# Only set things here that must live outside the app:

# Serve the session cookie only over HTTPS. Turn on when the page is behind a TLS proxy.
# COOKIE_SECURE=true

# Supply the encryption key yourself (e.g. from a secrets manager) instead of the
# generated /data/secret.key. Generate one with:
#   docker compose run --rm --entrypoint python watchtower -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later makes saved credentials unreadable; you'd re-enter them.
# APP_ENCRYPTION_KEY=

# LOG_LEVEL=INFO
